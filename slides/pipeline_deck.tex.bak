  \begin{column}{0.46\textwidth}
    \textbf{Reproduce in 3 commands:}\\[6pt]
    {\small\ttfamily\textcolor{ornlblack}{
    docker compose up -d\\
    bash process\_all.sh\\
    python 05\_render\_elsevier.py
    }}\\[12pt]
    \begin{itemize}
      \item All services pinned to image tags
      \item Runs on any Linux + GPU
      \item No API rate limits (SearXNG offline)
      \item Outputs: \texttt{.pdf}, \texttt{.bib}, \texttt{.jsonl}
    \end{itemize}
  \end{column}
\end{columns}
\end{frame}


