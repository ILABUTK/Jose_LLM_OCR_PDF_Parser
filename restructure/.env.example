# ── External vLLM engine (OpenAI-compatible) ─────────────────────────────────
# Mirror of the `llmlite` custom endpoint (ornl-qwen3-8-27b). Update the ngrok
# host whenever the tunnel rotates. Must end in /v1.
LLM_BASE_URL=https://75e4-160-36-103-252.ngrok-free.app/v1
LLM_MODEL=ornl-qwen3-8-27b
LLM_API_KEY=not-needed

# ── Graph-of-thought reasoning ───────────────────────────────────────────────
GRAPH_DEPTH=3
GRAPH_BRANCHING=3

# ── SVG figure generation (LLM-drawn, no ComfyUI/GPU) ─────────────────────────
PAPER_IMAGE_COUNT=2
SVG_MAX_TOKENS=6000

# ── Orchestration mode: pipeline | agent | idle ──────────────────────────────
PIPELINE_MODE=pipeline
